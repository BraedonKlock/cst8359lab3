@model List<Lab03.Models.Rsvp>

@{
    ViewData["Title"] = "Registrations";
}

<div class="container mt-4">

    <h1>Workshop Registrations</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No registrations have been submitted yet.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Workshop</th>
                    <th>Accommodation Required</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var registration in Model)
                {
                    <tr>
                        <td>@registration.FullName</td>
                        <td>@registration.WorkshopTitle</td>
                        <td>
                            @(registration.NeedsAccommodation ? "Yes" : "No")
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }

    <a asp-action="RsvpForm" class="btn btn-primary">
        New Registration
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Back to Workshops
    </a>

</div>
